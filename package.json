{
  "name": "atlas-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema demostrativo de gestión Atlas para el curso ISY1102",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/crypto.test.js test/validation.test.js test/integration/api.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:vitest": "vitest run --config vitest.config.mjs",
    "test:security": "node test/security/run.js",
    "test:all": "npm run test && npm run test:vitest",
    "test:coverage": "c8 --check-coverage --lines 70 --functions 70 --branches 70 --statements 70 --reporter=text --reporter=lcov --reports-dir=coverage node --test test/crypto.test.js test/validation.test.js test/integration/api.test.js",
    "quality": "npm run test:all && npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "supertest": "^7.1.1",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
