{
  "name": "atlas-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema demostrativo de gestión Atlas para el curso ISY1102",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reports-dir=coverage node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "supertest": "^7.1.1"
  }
}
